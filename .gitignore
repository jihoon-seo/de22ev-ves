# build outputs
/build/
/dist/
*.class
*.dex
*.jar
*.zip

# private resynthesis data (tools/resynth): recordings, packs and anything derived from them stay
# out of git; the tool code is public, its inputs and outputs are not
*.wav
pack.txt
*.vesmodel
*.segments.txt
*.track.txt
/private/
# except the built-in packs: 히릿's processed packs (tools/import_packs.py), shipped with their permission and
# their notice (THIRD_PARTY.md); never models, tracks, segments or original recordings
!/packs/*/pack.txt
!/packs/*/*.wav

# private signing keys: never commit (keys/author.key.pub is public and tracked)
*.key
*.pem
keys/*
!keys/author.key.pub
!keys/uuid.txt
*.p12
*.pass
