<?xml version="1.0" encoding="utf-8"?>
<!-- The split screen's 계기판 panel page (GaugeWidget; PanelService sends the frames, PanelFrame). The panel is about
     640 x 670 px = 427 x 447 dp at the car's 240 dpi. gp_* are PNGs ves.tools.PanelArt draws at build time (build.sh,
     drawable-nodpi); dial, lamps and needle share one box and scaleType fitCenter, so they make one square, the needle
     turns about the dial's centre and the lamps sit on the dial's ring.
     0.2.14 (owner): no power bar; the dial as big as the page allows (no disc, its centre below the middle, the needle
     pivots at 50% / 56%): its box takes the whole page below a 26 dp band,
     and the clock and the on/off button lie over the band and the square's empty top corners (ves.tools.PanelArt's
     panel-preview.png draws this layout). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF07090C">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:paddingTop="26dp"
        android:paddingBottom="2dp">

        <ImageView android:id="@+id/g_dial"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="fitCenter" android:src="@drawable/gp_dial_ice" />

        <!-- the shift lamps on the dial's ring as on the full gauge (0.2.14) -->
        <ImageView android:id="@+id/g_lamps"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="fitCenter" android:src="@drawable/gauge_lamps" />

        <ImageView android:id="@+id/g_flash"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="fitCenter" android:src="@drawable/gauge_flash" />

        <ImageView android:id="@+id/g_needle"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="fitCenter" android:src="@drawable/gauge_needle" />

        <!-- gear, speed and km/h a little below the dial's centre, which is 6% of the square below the box's middle
             (GaugeRenderer.DIAL_CY): the padding moves the block down by half its height -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="108dp">

            <TextView android:id="@+id/g_gear"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:includeFontPadding="false" android:singleLine="true"
                android:text="-" android:textColor="#FFF2F6FA" android:textSize="84sp" android:textStyle="bold|italic" />

            <TextView android:id="@+id/g_speed"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:includeFontPadding="false" android:singleLine="true" android:layout_marginTop="6dp"
                android:text="--" android:textColor="#FFF2F6FA" android:textSize="40sp" android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="km/h" android:textColor="#59FFFFFF" android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- over the top band and the dial square's empty corners: the clock (set by PanelService from ves.gauge.Clock)
         and the VES on/off button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="8dp"
        android:paddingTop="6dp">

        <TextView android:id="@+id/g_clock"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:singleLine="true" android:text="" android:textColor="#FFF2F6FA" android:textSize="18sp" />

        <Button android:id="@+id/g_toggle"
            android:layout_width="96dp" android:layout_height="32dp"
            android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
            android:background="@drawable/gauge_btn_unknown"
            android:gravity="center" android:singleLine="true"
            android:text="VES --" android:textColor="#FF8A9096" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
