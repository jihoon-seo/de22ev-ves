<?xml version="1.0" encoding="utf-8"?>
<!-- 0.2.13: the split screen's 계기판 panel page (GaugeWidget; PanelService sends the frames, PanelFrame). The panel is
     about 640 x 670 px = 427 x 447 dp at the car's 240 dpi. gp_* are PNGs ves.tools.PanelArt draws at build time
     (build.sh, drawable-nodpi); dial and needle share one square box so the needle turns about the dial's centre. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF07090C">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <!-- the clock (set each second by PanelService from ves.gauge.Clock) and the VES on/off button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView android:id="@+id/g_clock"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:singleLine="true" android:text="" android:textColor="#FFF2F6FA" android:textSize="19sp" />

            <Button android:id="@+id/g_toggle"
                android:layout_width="104dp" android:layout_height="34dp"
                android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                android:background="@drawable/gauge_btn_unknown"
                android:gravity="center" android:singleLine="true"
                android:text="VES --" android:textColor="#FF8A9096" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>

        <ImageView android:id="@+id/g_lamps"
            android:layout_width="320dp" android:layout_height="27dp"
            android:layout_gravity="center_horizontal" android:layout_marginTop="6dp"
            android:scaleType="fitCenter" android:src="@drawable/gauge_lamps" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="2dp">

            <ImageView android:id="@+id/g_dial"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitCenter" android:src="@drawable/gp_dial_ice" />

            <ImageView android:id="@+id/g_needle"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitCenter" android:src="@drawable/gauge_needle" />

            <!-- gear, speed and km/h a little below the centre, as in the gauge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="56dp">

                <TextView android:id="@+id/g_gear"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:includeFontPadding="false" android:singleLine="true"
                    android:text="-" android:textColor="#FFF2F6FA" android:textSize="58sp" android:textStyle="bold|italic" />

                <TextView android:id="@+id/g_speed"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:includeFontPadding="false" android:singleLine="true" android:layout_marginTop="4dp"
                    android:text="--" android:textColor="#FFF2F6FA" android:textSize="28sp" android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="km/h" android:textColor="#59FFFFFF" android:textSize="10sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- the power bars: regen grows from the centre to the left, drive to the right (ClipDrawables) -->
        <FrameLayout
            android:layout_width="320dp"
            android:layout_height="16dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp">

            <ImageView
                android:layout_width="match_parent" android:layout_height="8dp"
                android:layout_gravity="center_vertical" android:background="#24FFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <ImageView android:id="@+id/g_regen"
                    android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                    android:scaleType="fitXY" android:src="@drawable/gauge_bar_regen" />

                <ImageView android:id="@+id/g_drive"
                    android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                    android:scaleType="fitXY" android:src="@drawable/gauge_bar_drive" />
            </LinearLayout>

            <ImageView
                android:layout_width="2dp" android:layout_height="match_parent"
                android:layout_gravity="center_horizontal" android:background="#59FFFFFF" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="회생" android:textColor="#59FFFFFF" android:textSize="11sp" />

            <TextView
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:gravity="right" android:text="출력" android:textColor="#59FFFFFF" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
